% ============================================================
% elearning_documentation_i18n.sty
% Self-contained style for e-learning platform documentation
% - configurable platform and organization metadata
% - Polish / English labels through babel
% - documentation title page, headers, footers and watermark
% - code listings, notes, warnings, examples and requirement boxes
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{elearning_i18n}
  [2026/07/22 v1.1 Self-contained e-learning documentation style]

% ------------------------------------------------------------
% Core packages
% ------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[polish,english]{babel}

\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{eso-pic}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{xurl}
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage{xfp}
\RequirePackage[colorlinks=true]{hyperref}

\Urlmuskip=0mu plus 2mu\relax

% ------------------------------------------------------------
% Page geometry
% ------------------------------------------------------------
\geometry{
  a4paper,
  top=2.4cm,
  bottom=2.4cm,
  left=2.6cm,
  right=2.6cm,
  headheight=15pt,
  headsep=0.7cm,
  footskip=1.1cm
}

% ------------------------------------------------------------
% Color palette
% ------------------------------------------------------------
\definecolor{ElearnPrimary}{HTML}{2457A7}
\definecolor{ElearnSecondary}{HTML}{4B7BC1}
\definecolor{ElearnAccent}{HTML}{E8F1FF}
\definecolor{ElearnSuccess}{HTML}{2E7D32}
\definecolor{ElearnWarning}{HTML}{B26A00}
\definecolor{ElearnDanger}{HTML}{B3261E}
\definecolor{ElearnCodeBackground}{HTML}{F5F7FA}
\definecolor{ElearnBorder}{HTML}{D7DEE8}
\definecolor{ElearnMuted}{HTML}{5F6B7A}

\newcommand{\ElearnPrimaryColor}[1]{\colorlet{ElearnPrimary}{#1}}
\newcommand{\ElearnSecondaryColor}[1]{\colorlet{ElearnSecondary}{#1}}

% ------------------------------------------------------------
% Configurable document metadata
% ------------------------------------------------------------
% The package deliberately does not hardcode a product name.
% Configure the current platform in the document preamble:
%
%   \ElearnPlatformName{Delta}
%   \ElearnOrganization{Your organization}
%   \ElearnDocumentVersion{1.0}
%   \ElearnDocumentStatus{Draft}
%
\newcommand{\ElearnPlatformNameValue}{E-Learning Platform}
\newcommand{\ElearnOrganizationValue}{}
\newcommand{\ElearnDocumentTypeValue}{Platform Documentation}
\newcommand{\ElearnDocumentTitleValue}{Platform Documentation}
\newcommand{\ElearnDocumentSubtitleValue}{}
\newcommand{\ElearnDocumentVersionValue}{0.1}
\newcommand{\ElearnDocumentStatusValue}{Draft}
\newcommand{\ElearnDocumentOwnerValue}{}
\newcommand{\ElearnDocumentAudienceValue}{}
\newcommand{\ElearnDocumentDateValue}{\today}
\newcommand{\ElearnDocumentKeywordsValue}{e-learning, documentation, platform}

\newcommand{\ElearnPlatformName}[1]{\renewcommand{\ElearnPlatformNameValue}{#1}}
\newcommand{\ElearnOrganization}[1]{\renewcommand{\ElearnOrganizationValue}{#1}}
\newcommand{\ElearnDocumentType}[1]{\renewcommand{\ElearnDocumentTypeValue}{#1}}
\newcommand{\ElearnDocumentTitle}[1]{\renewcommand{\ElearnDocumentTitleValue}{#1}}
\newcommand{\ElearnDocumentSubtitle}[1]{\renewcommand{\ElearnDocumentSubtitleValue}{#1}}
\newcommand{\ElearnDocumentVersion}[1]{\renewcommand{\ElearnDocumentVersionValue}{#1}}
\newcommand{\ElearnDocumentStatus}[1]{\renewcommand{\ElearnDocumentStatusValue}{#1}}
\newcommand{\ElearnDocumentOwner}[1]{\renewcommand{\ElearnDocumentOwnerValue}{#1}}
\newcommand{\ElearnDocumentAudience}[1]{\renewcommand{\ElearnDocumentAudienceValue}{#1}}
\newcommand{\ElearnDocumentDate}[1]{\renewcommand{\ElearnDocumentDateValue}{#1}}
\newcommand{\ElearnDocumentKeywords}[1]{\renewcommand{\ElearnDocumentKeywordsValue}{#1}}

% ------------------------------------------------------------
% Configurable title-page logo
% ------------------------------------------------------------
% The logo path is resolved relative to the main .tex file / compilation
% working directory. With pdfLaTeX use PDF, PNG or JPG.
%
% Example:
%   \ElearnLogoPath{assets/delta-logo.png}
%   \ElearnLogoWidthPercent{24}  % 24 percent of \textwidth
%
% Logo scaling is controlled only by its width as a percentage of \textwidth.
% Its original aspect ratio is always preserved. A missing or empty path does
% not stop compilation; the logo is omitted and a warning is written to the log.
\newcommand{\ElearnLogoPathValue}{}
\newcommand{\ElearnLogoWidthPercentValue}{24}

\newif\ifElearnLogoEnabled
\ElearnLogoEnabledtrue

\newcommand{\ElearnLogoPath}[1]{%
  \renewcommand{\ElearnLogoPathValue}{#1}%
}

\newcommand{\ElearnLogoWidthPercent}[1]{%
  \renewcommand{\ElearnLogoWidthPercentValue}{#1}%
}

\newcommand{\ElearnLogoOff}{\ElearnLogoEnabledfalse}
\newcommand{\ElearnLogoOn}{\ElearnLogoEnabledtrue}

\newcommand{\ElearnRenderTitleLogo}{%
  \ifElearnLogoEnabled
    \ifdefempty{\ElearnLogoPathValue}{}{%
      \IfFileExists{\ElearnLogoPathValue}{%
        \includegraphics[
          width=\fpeval{\ElearnLogoWidthPercentValue/100}\textwidth,
          keepaspectratio
        ]{\ElearnLogoPathValue}\par
      }{%
        \PackageWarning{elearning_documentation_i18n}{%
          Logo file `\ElearnLogoPathValue' not found; title-page logo omitted%
        }%
      }%
    }%
  \fi
}

