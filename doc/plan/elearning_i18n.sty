% ------------------------------------------------------------
% Footer and confidentiality overrides
% ------------------------------------------------------------
\newcommand{\ElearnFooterTextCustom}{}
\newcommand{\ElearnConfidentialityValue}{}

\newcommand{\ElearnFooterText}[1]{\renewcommand{\ElearnFooterTextCustom}{#1}}
\newcommand{\ElearnConfidentiality}[1]{\renewcommand{\ElearnConfidentialityValue}{#1}}

\newcommand{\ElearnResolvedFooterText}{%
  \ifdefempty{\ElearnFooterTextCustom}{%
    \ifdefempty{\ElearnOrganizationValue}{%
      \ElearnResolvedRightsLabel. \copyright\ \ElearnPlatformNameValue
    }{%
      \ElearnResolvedRightsLabel. \copyright\ \ElearnOrganizationValue
    }%
  }{%
    \ElearnFooterTextCustom
  }%
}

% ------------------------------------------------------------
% Configurable watermark
% ------------------------------------------------------------
% Examples:
%   \ElearnWatermarkText{\ElearnPlatformNameValue}
%   \ElearnWatermarkColor{black!6}
%   \ElearnWatermarkFontSize{38}{46}
%   \ElearnWatermarkAngle{35}
%   \ElearnWatermarkOff
%
\newcommand{\ElearnWatermarkTextValue}{\ElearnPlatformNameValue}
\newcommand{\ElearnWatermarkColorValue}{black!7}
\newcommand{\ElearnWatermarkSizeValue}{42}
\newcommand{\ElearnWatermarkBaselineValue}{50}
\newcommand{\ElearnWatermarkAngleValue}{45}

\newif\ifElearnWatermarkEnabled
\ElearnWatermarkEnabledtrue

\newcommand{\ElearnWatermarkText}[1]{%
  \renewcommand{\ElearnWatermarkTextValue}{#1}%
  \ifElearnWatermarkEnabled
    \ClearShipoutPictureBG
    \ElearnInstallWatermark
  \fi
}

\newcommand{\ElearnWatermarkColor}[1]{%
  \renewcommand{\ElearnWatermarkColorValue}{#1}%
}

\newcommand{\ElearnWatermarkFontSize}[2]{%
  \renewcommand{\ElearnWatermarkSizeValue}{#1}%
  \renewcommand{\ElearnWatermarkBaselineValue}{#2}%
}

\newcommand{\ElearnWatermarkAngle}[1]{%
  \renewcommand{\ElearnWatermarkAngleValue}{#1}%
}

\newcommand{\ElearnInstallWatermark}{%
  \ifElearnWatermarkEnabled
    \AddToShipoutPictureBG{%
      \AtPageCenter{%
        \makebox[0pt]{%
          \rotatebox{\ElearnWatermarkAngleValue}{%
            \textcolor{\ElearnWatermarkColorValue}{%
              \fontsize{\ElearnWatermarkSizeValue}
                {\ElearnWatermarkBaselineValue}\selectfont
              \bfseries \ElearnWatermarkTextValue
            }%
          }%
        }%
      }%
    }%
  \fi
}

\newcommand{\ElearnWatermarkOff}{%
  \ElearnWatermarkEnabledfalse
  \ClearShipoutPictureBG
}

\newcommand{\ElearnWatermarkOn}{%
  \ElearnWatermarkEnabledtrue
  \ClearShipoutPictureBG
  \ElearnInstallWatermark
}

\newcommand{\ElearnWatermarkStrong}{%
  \ElearnWatermarkColor{black!16}%
  \ElearnWatermarkOn
}

% ------------------------------------------------------------
% Header and footer
% ------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}

\fancyhead[L]{%
  \small\bfseries\color{ElearnPrimary}\ElearnPlatformNameValue}
\fancyhead[C]{%
  \small\color{ElearnMuted}\ElearnDocumentTypeValue}
\fancyhead[R]{%
  \small\color{ElearnMuted}%
  \ElearnResolvedVersionLabel\ \ElearnDocumentVersionValue}

\fancyfoot[L]{\scriptsize\color{ElearnMuted}\ElearnResolvedFooterText}
\fancyfoot[R]{\small\thepage}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[L]{\scriptsize\color{ElearnMuted}\ElearnResolvedFooterText}
  \fancyfoot[R]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% ------------------------------------------------------------
% PDF metadata
% ------------------------------------------------------------
\AtBeginDocument{%
  \hypersetup{
    linkcolor=ElearnPrimary,
    urlcolor=ElearnSecondary,
    citecolor=ElearnPrimary,
    pdfauthor={\ElearnOrganizationValue},
    pdftitle={\ElearnDocumentTitleValue\space---\space\ElearnPlatformNameValue},
    pdfsubject={\ElearnDocumentTypeValue},
    pdfkeywords={\ElearnDocumentKeywordsValue},
    bookmarksopen=true,
    bookmarksnumbered=true
  }%
  \ElearnInstallWatermark
  \renewcommand{\contentsname}{\ElearnResolvedContentsLabel}%
}

% ------------------------------------------------------------
% Heading styles
% ------------------------------------------------------------
\titleformat{\chapter}[display]
  {\normalfont\bfseries\color{ElearnPrimary}}
  {\filleft\Large\chaptertitlename\ \thechapter}
  {0.8ex}
  {\titlerule\vspace{1ex}\Huge}
  [\vspace{0.7ex}\titlerule]

\titleformat{\section}
  {\normalfont\Large\bfseries\color{ElearnPrimary}}
  {\thesection}
  {0.8em}
  {}

\titleformat{\subsection}
  {\normalfont\large\bfseries\color{ElearnSecondary}}
  {\thesubsection}
  {0.8em}
  {}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsubsection}
  {0.8em}
  {}

\titlespacing*{\chapter}{0pt}{-10pt}{28pt}
\titlespacing*{\section}{0pt}{2.4ex plus .5ex minus .2ex}{1.0ex}
\titlespacing*{\subsection}{0pt}{2.0ex plus .4ex minus .2ex}{0.8ex}

% ------------------------------------------------------------
% Lists, tables, figures and paragraphs
% ------------------------------------------------------------
\setlist{
  topsep=0.5em,
  itemsep=0.25em,
  parsep=0pt
}
\setlist[itemize,1]{label=\textcolor{ElearnPrimary}{\textbullet}}
\setlist[enumerate,1]{label=\textcolor{ElearnPrimary}{\arabic*.}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.65em}
\setlength{\emergencystretch}{3em}

\captionsetup{
  font=small,
  labelfont={bf,color=ElearnPrimary},
  justification=raggedright,
  singlelinecheck=false
}

\renewcommand{\arraystretch}{1.18}

% ------------------------------------------------------------
% Code listings
% ------------------------------------------------------------
\lstdefinestyle{ElearnCodeStyle}{
  backgroundcolor=\color{ElearnCodeBackground},
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries\color{ElearnPrimary},
  commentstyle=\itshape\color{ElearnMuted},
  stringstyle=\color{ElearnSuccess},
  numbers=left,
  numberstyle=\scriptsize\color{ElearnMuted},
  numbersep=10pt,
  frame=single,
  rulecolor=\color{ElearnBorder},
  breaklines=true,
  breakatwhitespace=false,
  showstringspaces=false,
  tabsize=2,
  columns=fullflexible,
  keepspaces=true,
  xleftmargin=0.5em,
  xrightmargin=0.5em,
  aboveskip=0.8em,
  belowskip=0.8em
}

\lstnewenvironment{ElearnCode}[1][]
  {\lstset{style=ElearnCodeStyle,#1}}
  {}

\newcommand{\ElearnInlineCode}[1]{%
  \colorbox{ElearnCodeBackground}{\texttt{\detokenize{#1}}}%
}

% ------------------------------------------------------------
% Documentation boxes
% ------------------------------------------------------------
\tcbset{
  elearnbox/.style={
    enhanced,
    breakable,
    boxrule=0.7pt,
    arc=2pt,
    left=8pt,
    right=8pt,
    top=7pt,
    bottom=7pt,
    before skip=0.8em,
    after skip=0.8em,
    fonttitle=\bfseries
  }
}

\newtcolorbox{ElearnNote}[1][]{%
  elearnbox,
  colback=ElearnAccent,
  colframe=ElearnPrimary,
  title=\ElearnResolvedNoteLabel,
  #1
}

\newtcolorbox{ElearnImportant}[1][]{%
  elearnbox,
  colback=ElearnSuccess!7,
  colframe=ElearnSuccess,
  title=\ElearnResolvedImportantLabel,
  #1
}

\newtcolorbox{ElearnWarning}[1][]{%
  elearnbox,
  colback=ElearnWarning!8,
  colframe=ElearnWarning,
  title=\ElearnResolvedWarningLabel,
  #1
}

\newtcolorbox{ElearnExample}[1][]{%
  elearnbox,
  colback=ElearnCodeBackground,
  colframe=ElearnSecondary,
  title=\ElearnResolvedExampleLabel,
