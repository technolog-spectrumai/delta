% ------------------------------------------------------------
% Title page
% ------------------------------------------------------------
% Configure metadata in the preamble, then call:
%
%   \ElearnTitlePage
%
% Required before use:
%   \ElearnPlatformName{Delta}
%   \ElearnDocumentTitle{Dokumentacja platformy}
%
\newcommand{\ElearnMetadataRow}[2]{%
  \textbf{#1} & #2\\[0.22em]
}

\newcommand{\ElearnTitlePage}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \centering

    % Compact top block
    \vspace*{0.35cm}

    {\large\color{ElearnMuted}\ElearnDocumentTypeValue\par}
    \vspace{0.25cm}

    {\LARGE\bfseries\color{ElearnPrimary}\ElearnPlatformNameValue\par}
    \vspace{0.45cm}

    \textcolor{ElearnPrimary}{\rule{0.94\textwidth}{1.2pt}}
    \vspace{0.35cm}

    {\huge\bfseries\ElearnDocumentTitleValue\par}

    % Logo sits directly below the document title and above its description.
    \ifdefempty{\ElearnLogoPathValue}{}{%
      \vspace{0.28cm}
      \ElearnRenderTitleLogo
    }

    \ifdefempty{\ElearnDocumentSubtitleValue}{}{%
      \vspace{0.28cm}
      {\large\itshape\color{ElearnMuted}\ElearnDocumentSubtitleValue\par}
    }

    \vspace{0.35cm}
    \textcolor{ElearnPrimary}{\rule{0.94\textwidth}{1.2pt}}

    \vspace{0.55cm}

    \begin{tcolorbox}[
      width=0.90\textwidth,
      colback=white,
      colframe=ElearnBorder,
      boxrule=0.7pt,
      arc=2pt,
      left=8pt,
      right=8pt,
      top=6pt,
      bottom=6pt
    ]
      \small
      \renewcommand{\arraystretch}{1.05}
      \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}p{0.31\linewidth}X@{}}
        \ElearnMetadataRow{\ElearnResolvedPlatformLabel}{\ElearnPlatformNameValue}
        \ElearnMetadataRow{\ElearnResolvedVersionLabel}{\ElearnDocumentVersionValue}
        \ElearnMetadataRow{\ElearnResolvedStatusLabel}{\ElearnDocumentStatusValue}
        \ifdefempty{\ElearnDocumentOwnerValue}{}{%
          \ElearnMetadataRow{\ElearnResolvedOwnerLabel}{\ElearnDocumentOwnerValue}
        }
        \ifdefempty{\ElearnDocumentAudienceValue}{}{%
          \ElearnMetadataRow{\ElearnResolvedAudienceLabel}{\ElearnDocumentAudienceValue}
        }
        \ElearnMetadataRow{\ElearnResolvedUpdatedLabel}{\ElearnDocumentDateValue}
      \end{tabularx}
    \end{tcolorbox}

    \vfill

    \ifdefempty{\ElearnOrganizationValue}{}{%
      {\normalsize\bfseries \ElearnOrganizationValue\par}
      \vspace{0.18cm}
    }

    \ifdefempty{\ElearnConfidentialityValue}{}{%
      {\small\bfseries\color{ElearnDanger}\ElearnConfidentialityValue\par}
      \vspace{0.18cm}
    }

    {\scriptsize\color{ElearnMuted}\ElearnResolvedFooterText\par}
    \vspace*{0.15cm}
  \end{titlepage}
}

% ------------------------------------------------------------
% Convenience macro for the standard opening pages
% ------------------------------------------------------------
\newcommand{\ElearnFrontMatter}{%
  \pagenumbering{roman}
  \ElearnTitlePage
  \setcounter{page}{2}
  \tableofcontents
  \clearpage
  \pagenumbering{arabic}
}



