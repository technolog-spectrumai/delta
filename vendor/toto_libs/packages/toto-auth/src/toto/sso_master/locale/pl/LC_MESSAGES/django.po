msgid "Error:"
msgstr "Błąd:"

#: templates/sso/admin_test_result.html:14
msgid "Back"
msgstr "Wróć"

#: templates/sso/admin_test_result.html:17
msgid "Authorization code flow completed successfully for"
msgstr "Przepływ kodu autoryzacji zakończony pomyślnie dla"

#: templates/sso/admin_test_result.html:21
msgid "User Claims"
msgstr "Oświadczenia użytkownika"

#: templates/sso/admin_test_result.html:24
msgid "Claim"
msgstr "Oświadczenie"

#: templates/sso/admin_test_result.html:24
