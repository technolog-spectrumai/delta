#: templates/admin/platform_backup_console.html:25
msgid ""
"Select apps and create a backup ZIP. You can download it now or store it for "
"remote API pull."
msgstr "Wybierz aplikacje i utwórz kopię zapasową ZIP. Możesz ją teraz pobrać lub zapisać do zdalnego pobrania przez API."

#: templates/admin/platform_backup_console.html:29
msgid "Apps:"
msgstr "Aplikacje:"

#: templates/admin/platform_backup_console.html:41
msgid "Options:"
msgstr "Opcje:"

#: templates/admin/platform_backup_console.html:44
msgid "Sign backup"
msgstr "Podpisz kopię zapasową"

#: templates/admin/platform_backup_console.html:48
msgid "Create &amp; download backup"
msgstr "Utwórz i pobierz kopię zapasową"

#: templates/admin/platform_backup_console.html:49
msgid "Create stored backup"
msgstr "Utwórz przechowywaną kopię zapasową"

#: templates/admin/platform_seed_console.html:19
msgid "Upload a signed or unsigned backup ZIP and seed this portal from it."
msgstr "Wgraj podpisaną lub niepodpisaną kopię zapasową ZIP i zainicjuj z niej ten portal."
