#: templates/admin/secretkey_reveal.html:6
msgid "Reveal Secret Key"
msgstr "Ujawnij tajny klucz"

#: templates/admin/secretkey_reveal.html:8
msgid ""
"You are about to reveal the selected secret(s). Enter the passphrase to "
"continue."
msgstr "Zamierzasz ujawnić wybrane sekrety. Wpisz frazę hasłową, aby kontynuować."

#: templates/admin/secretkey_reveal.html:13
#: templates/admin/secretkey_rotate.html:14
msgid "Passphrase:"
msgstr "Fraza hasłowa:"

#: templates/admin/secretkey_reveal.html:16
msgid "Reveal"
msgstr "Ujawnij"

#: templates/admin/secretkey_reveal.html:17
#: templates/admin/secretkey_rotate.html:19
msgid "Cancel"
msgstr "Anuluj"

#: templates/admin/secretkey_rotate.html:6
msgid "Rotate Secret Key"
msgstr "Zrotuj tajny klucz"

#: templates/admin/secretkey_rotate.html:18
msgid "Rotate"
msgstr "Zrotuj"

#: templates/gervazy/_provision_signing_key_form.html:6
msgid ""
"Strongbox password — used only to decrypt your private key in memory. Never "
"stored."
msgstr "Hasło sejfu — używane wyłącznie do odszyfrowania Twojego klucza prywatnego w pamięci. Nigdy nie jest zapisywane."

#: templates/gervazy/_provision_signing_key_form.html:10
msgid "Strongbox"
msgstr "Sejf"

#: templates/gervazy/_provision_signing_key_form.html:22
msgid "Password *"
msgstr "Hasło *"

#: templates/gervazy/my_keys.html:20
msgid "Gervazy"
msgstr "Gervazy"

#: templates/gervazy/my_keys.html:22
msgid "My Keys"
msgstr "Moje klucze"

#: templates/gervazy/my_keys.html:23
msgid "Signing keys and strongboxes associated with your account."
msgstr "Klucze podpisujące i sejfy powiązane z Twoim kontem."

#: templates/gervazy/my_keys.html:29
msgid "My Profile"
msgstr "Mój profil"

#: templates/gervazy/my_keys.html:53
msgid "Signing Keys"
msgstr "Klucze podpisujące"

#: templates/gervazy/my_keys.html:54
msgid "Ed25519 keys used to cryptographically sign documents."
msgstr "Klucze Ed25519 używane do kryptograficznego podpisywania dokumentów."

#: templates/gervazy/my_keys.html:65
msgid "No Person profile linked to your account."
msgstr "Brak profilu osoby powiązanego z Twoim kontem."

#: templates/gervazy/my_keys.html:76
msgid "Active"
msgstr "Aktywny"

#: templates/gervazy/my_keys.html:79
msgid "Retired"
msgstr "Wycofany"

#: templates/gervazy/my_keys.html:109
msgid "Rotate signing key"
msgstr "Zrotuj klucz podpisujący"

#: templates/gervazy/my_keys.html:118
msgid "No signing keys yet. Provision one below."
msgstr "Nie masz jeszcze kluczy podpisujących. Utwórz jeden poniżej."

#: templates/gervazy/my_keys.html:122
msgid "Set up a strongbox first."
msgstr "Najpierw skonfiguruj sejf."

#: templates/gervazy/my_keys.html:134
msgid "Strongboxes"
msgstr "Sejfy"

#: templates/gervazy/my_keys.html:135
msgid "Encrypted key stores belonging to your account."
msgstr "Zaszyfrowane magazyny kluczy należące do Twojego konta."

#: templates/gervazy/my_keys.html:174 templates/gervazy/my_keys.html:195
msgid "Initialize"
msgstr "Zainicjuj"

#: templates/gervazy/my_keys.html:181
msgid "Enter your strongbox password to generate a master key and data key."
msgstr "Wpisz hasło sejfu, aby wygenerować klucz główny i klucz danych."

#: templates/gervazy/my_keys.html:186
msgid "Strongbox password"
msgstr "Hasło sejfu"

#: templates/gervazy/my_keys.html:205
msgid "No strongboxes found. Ask an administrator to set one up for you."
msgstr "Nie znaleziono sejfów. Poproś administratora, aby skonfigurował Ci sejf."
